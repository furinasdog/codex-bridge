# Server
CODEX_BRIDGE_ADDRESS=127.0.0.1:8787
CODEX_BRIDGE_MODEL=gpt-6.1-sol
CODEX_BRIDGE_LOG_LEVEL=info

# Required when listening on a non-loopback address; recommended otherwise.
# CODEX_BRIDGE_API_KEY=replace-with-a-long-random-value

# Optional advanced settings
# CODEX_BRIDGE_UPSTREAM_URL=https://api.openai.com/v1
# CODEX_BRIDGE_CREDENTIALS=/absolute/path/to/credentials.json
# CODEX_BRIDGE_ALLOWED_ORIGINS=http://127.0.0.1:3000
# CODEX_BRIDGE_MAX_BODY_BYTES=33554432
# CODEX_BRIDGE_REQUEST_TIMEOUT=10m

# Non-interactive alternative to `codex-bridge login`. The token is not saved.
# CODEX_ACCESS_TOKEN=
